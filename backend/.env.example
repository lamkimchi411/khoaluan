DB_DRIVER=postgres
# Runtime Neon. MySQL bên dưới là nguồn migration/dự phòng (DB_DRIVER=mysql).
# Lấy connection string từ Connect trong project Neon.
NEON_DATABASE_URL=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=brandpulse
# Nguồn dữ liệu cho lệnh migrate:mysql; file gốc được giữ nguyên.
SQLITE_PATH=data/brandpulse.db
